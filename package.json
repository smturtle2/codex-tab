{
  "name": "codex-tab",
  "displayName": "Codex Tab",
  "description": "code-server-only ghost text autocomplete backed by Codex OAuth PKCE sign-in.",
  "version": "0.0.7",
  "publisher": "smturtle2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/smturtle2/codex-tab.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "autocomplete",
    "code-server",
    "ghost-text"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexAutocomplete.signIn",
    "onCommand:codexAutocomplete.signOut",
    "onCommand:codexAutocomplete.checkSetup",
    "onCommand:codexAutocomplete.reloadAuth",
    "onCommand:codexAutocomplete.openLogs",
    "onCommand:codexAutocomplete.selectModel",
    "onCommand:codexAutocomplete.selectReasoningEffort",
    "onCommand:codexAutocomplete.acceptNextWord",
    "onLanguage:*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexAutocomplete.signIn",
        "title": "Codex Tab: Sign In"
      },
      {
        "command": "codexAutocomplete.signOut",
        "title": "Codex Tab: Sign Out"
      },
      {
        "command": "codexAutocomplete.checkSetup",
        "title": "Codex Tab: Check Setup"
      },
      {
        "command": "codexAutocomplete.reloadAuth",
        "title": "Codex Tab: Reload Auth"
      },
      {
        "command": "codexAutocomplete.openLogs",
        "title": "Codex Tab: Open Logs"
      },
      {
        "command": "codexAutocomplete.selectModel",
        "title": "Codex Tab: Select Model"
      },
      {
        "command": "codexAutocomplete.selectReasoningEffort",
        "title": "Codex Tab: Select Reasoning Effort"
      },
      {
        "command": "codexAutocomplete.acceptNextWord",
        "title": "Codex Tab: Accept Next Word"
      }
    ],
    "configuration": {
      "title": "Codex Tab",
      "properties": {
        "codexAutocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Codex Tab inline completions."
        },
        "codexAutocomplete.model": {
          "type": "string",
          "default": "gpt-5.4-mini",
          "description": "Model used for inline completions. Use the \"Codex Tab: Select Model\" command to browse the live account model list."
        },
        "codexAutocomplete.reasoningEffort": {
          "type": "string",
          "default": "low",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "Disable model reasoning when supported by the selected model.",
            "Use the lightest supported reasoning for fast completions.",
            "Use low reasoning effort.",
            "Use medium reasoning effort.",
            "Use high reasoning effort.",
            "Use the highest supported reasoning effort."
          ],
          "description": "Reasoning effort sent with completion requests. Use the \"Codex Tab: Select Reasoning Effort\" command for a model-aware menu."
        },
        "codexAutocomplete.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "Wait time before sending an inline completion request."
        },
        "codexAutocomplete.maxPrefixChars": {
          "type": "number",
          "default": 4000,
          "minimum": 256,
          "description": "Maximum prefix context characters sent to Codex."
        },
        "codexAutocomplete.maxSuffixChars": {
          "type": "number",
          "default": 1200,
          "minimum": 0,
          "description": "Maximum suffix context characters sent to Codex."
        },
        "codexAutocomplete.requestTimeoutMs": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "description": "HTTP timeout for model list, setup probe, and completion requests."
        }
      }
    },
    "keybindings": [
      {
        "command": "codexAutocomplete.acceptNextWord",
        "key": "shift+tab",
        "when": "inlineSuggestionVisible && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/test/**/*.test.ts",
    "package:vsix": "npm run build && vsce package --no-dependencies",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^2.31.1",
    "esbuild": "^0.25.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
